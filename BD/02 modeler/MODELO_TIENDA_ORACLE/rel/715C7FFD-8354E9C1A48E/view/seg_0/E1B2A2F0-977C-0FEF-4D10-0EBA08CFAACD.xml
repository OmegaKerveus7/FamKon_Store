<userDefinedSQL><![CDATA[CREATE OR REPLACE VIEW VW_TRACKING_PEDIDO
AS 
SELECT
    P.ID_PEDIDO,
    P.NUMERO_PEDIDO,
    H.ID_HISTORIAL,
    EP.CODIGO AS CODIGO_ESTADO,
    EP.NOMBRE AS ESTADO,
    EP.ORDEN_VISUAL,
    H.FECHA_ESTADO,
    H.COMENTARIO,
    H.ID_USUARIO_ACTOR,
    U.NICKNAME AS USUARIO_ACTOR
FROM PEDIDO P
INNER JOIN PEDIDO_ESTADO_HISTORIAL H ON H.ID_PEDIDO = P.ID_PEDIDO
INNER JOIN ESTADO_PEDIDO EP ON EP.ID_ESTADO_PEDIDO = H.ID_ESTADO_PEDIDO
LEFT JOIN USUARIO U ON U.ID_USUARIO = H.ID_USUARIO_ACTOR]]></userDefinedSQL>
