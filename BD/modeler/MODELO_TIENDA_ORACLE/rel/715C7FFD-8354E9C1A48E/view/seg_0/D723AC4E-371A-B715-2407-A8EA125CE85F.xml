<userDefinedSQL><![CDATA[CREATE OR REPLACE VIEW VW_PEDIDO_RESUMEN
AS 
SELECT
    P.ID_PEDIDO,
    P.NUMERO_PEDIDO,
    P.FECHA_PEDIDO,
    P.ID_USUARIO,
    U.NICKNAME AS COMPRADOR,
    U.CORREO,
    P.ID_SITIO,
    S.NOMBRE AS SITIO,
    EP.CODIGO AS CODIGO_ESTADO,
    EP.NOMBRE AS ESTADO_PEDIDO,
    AE.NOMBRE AS AREA_ENTREGA,
    P.SUBTOTAL,
    P.CARGO_ENTREGA,
    P.TOTAL,
    P.COD_MONEDA
FROM PEDIDO P
INNER JOIN USUARIO U ON U.ID_USUARIO = P.ID_USUARIO
INNER JOIN SITIO S ON S.ID_SITIO = P.ID_SITIO
INNER JOIN ESTADO_PEDIDO EP ON EP.ID_ESTADO_PEDIDO = P.ID_ESTADO_PEDIDO
INNER JOIN AREA_ENTREGA AE ON AE.ID_AREA_ENTREGA = P.ID_AREA_ENTREGA]]></userDefinedSQL>
